ARG WEB_IMAGE
ARG API_IMAGE
FROM ${API_IMAGE} AS api
FROM ${WEB_IMAGE}
USER root
RUN apk upgrade --no-cache \
    && apk add --no-cache libstdc++ \
    && mkdir -p /app \
    && sed -e 's/listen 80;/listen 8081;/' \
        -e 's#http://api:8080#http://127.0.0.1:8080#g' \
        -e 's/proxy_set_header X-Forwarded-Proto $scheme;/proxy_set_header X-Forwarded-Proto https;/' \
        -e 's#include /etc/nginx/autocuidado/\*.conf;#real_ip_header X-Autocuidado-Client-IP; set_real_ip_from 0.0.0.0/0; set_real_ip_from ::/0; if ($autocuidado_origin_ok = 0) { return 403; } add_header Strict-Transport-Security "max-age=31536000" always;#' \
        /etc/nginx/conf.d/default.conf > /app/frontend-nginx.conf
COPY --from=api /opt/java/openjdk/ /opt/java/openjdk/
COPY --from=api /app/autocuidado.jar /app/autocuidado.jar
COPY deploy/nginx.cloudflare.conf /app/nginx.cloudflare.conf
COPY --chmod=755 deploy/start-cloudflare.sh /app/start-cloudflare.sh
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=/opt/java/openjdk/bin:$PATH
USER 10001:10001
EXPOSE 8081
STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/start-cloudflare.sh"]
